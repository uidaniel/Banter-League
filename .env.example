# Copy to .env.local and fill from your Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Football data provider ----
# fpl          = Fantasy Premier League official API (DEFAULT). Free, no key, live PL
#                season, accurate anytime-scorers. (No first-goalscorer timing.)
# apifootball  = API-Football (api-sports.io). Needs API_FOOTBALL_KEY below; has
#                first-goalscorer timing + multi-league/historical, but the free plan
#                blocks the current season.
FOOTBALL_PROVIDER=fpl

# Only needed when FOOTBALL_PROVIDER=apifootball. Server-only; do NOT prefix NEXT_PUBLIC.
API_FOOTBALL_KEY=

# ---- Automation (the autonomous gameweek engine) ----
# Service-role key from Supabase → Settings → API. Used ONLY server-side by the
# engine/cron to manage gameweeks across leagues (bypasses RLS). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the cron caller must present as `Authorization: Bearer <CRON_SECRET>`.
# On Vercel, set this in project env and Vercel Cron sends it automatically.
CRON_SECRET=

